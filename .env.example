# Supabase → Project Settings → API. Solo la anon key: la service key nunca va al frontend.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# true = la app usa datos mock y no habla con Supabase (ni pide captcha)
VITE_USE_MOCK_DATA=false

# Cloudflare Turnstile para el alta anónima (S0.1). La clave del sitio es pública; sin ella no se pide captcha.
# Local (Supabase con config.toml): 1x00000000000000000000BB, la clave de prueba invisible que siempre pasa.
# Producción: la clave real del sitio, configurada en Vercel.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB
